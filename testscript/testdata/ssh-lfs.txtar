# vi: set ft=conf

[windows] dos2unix err1.txt err2.txt errauth.txt errrepo.txt

# enable ssh lfs transfer
env SOFT_SERVE_LFS_SSH_ENABLED=true
# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create a user
soft user create foo --key "$USER1_AUTHORIZED_KEY"

# create a repo
soft repo create repo1
soft repo create repo1p -p
usoft repo create repo2
usoft repo create repo2p -p

# SSH Git LFS Transfer command
! soft git-lfs-transfer
cmp stderr err1.txt
! soft git-lfs-transfer repo1
cmp stderr err2.txt
soft git-lfs-transfer repo1 download
stdout '000eversion=1\n000clocking\n0000'
soft git-lfs-transfer repo1 upload
stdout '000eversion=1\n000clocking\n0000'
usoft git-lfs-transfer repo1 download
stdout '000eversion=1\n000clocking\n0000'
! usoft git-lfs-transfer repo1 upload
cmp stderr errauth.txt

# Unauthorized user
! usoft git-lfs-transfer
cmp stderr err1.txt
! usoft git-lfs-transfer repo1p
cmp stderr err2.txt
# a private repo the user cannot read answers like a missing one
! usoft git-lfs-transfer repo1p download
cmp stderr errrepo.txt
! usoft git-lfs-transfer repo1p upload
cmp stderr errrepo.txt
! usoft git-lfs-transfer foobar download
cmp stderr errrepo.txt
! usoft git-lfs-transfer foobar upload
cmp stderr errrepo.txt

# push & create repo with some files, commits, tags...
mkdir ./repo1
git -c init.defaultBranch=master -C repo1 init
mkfile ./repo1/README.md '# Project\nfoo'
mkfile ./repo1/foo.png 'foo'
mkfile ./repo1/bar.png 'bar'
git -C repo1 remote add origin ssh://localhost:$SSH_PORT/repo1
git -C repo1 lfs install --local
git -C repo1 lfs track '*.png'
git -C repo1 add -A
git -C repo1 commit -m 'first'
git -C repo1 tag v0.1.0
# Trace git-lfs so the push can be shown to use git-lfs-transfer. If pure SSH
# fails, git-lfs silently falls back to git-lfs-authenticate and HTTP, which
# the server also offers, so the transfer must be checked in the trace.
env GIT_TRACE=1
git -C repo1 push origin HEAD
stderr 'git-lfs-transfer'
stderr 'pure SSH connection successful'
! stderr 'pure SSH protocol connection failed'
! stderr 'git-lfs-authenticate'
env GIT_TRACE=
git -C repo1 push origin HEAD --tags

# clone repo with ssh lfs-transfer
# System and global git config are not read in tests, so the LFS filter is
# configured on the clone itself; without it checkout leaves pointer files
# and nothing is downloaded over lfs-transfer.
# The trace shows the objects came over git-lfs-transfer and not the HTTP
# fallback.
env GIT_TRACE=1
git clone -c filter.lfs.process='git-lfs filter-process' -c filter.lfs.required=true ssh://localhost:$SSH_PORT/repo1 repo1c
stderr 'git-lfs-transfer'
stderr 'pure SSH connection successful'
! stderr 'pure SSH protocol connection failed'
! stderr 'git-lfs-authenticate'
env GIT_TRACE=
exists repo1c/README.md
grep '^foo$' repo1c/foo.png
grep '^bar$' repo1c/bar.png
exists repo1c/.git/lfs/objects

# stop the server
[windows] stopserver

-- err1.txt --
Error: accepts 2 arg(s), received 0
-- err2.txt --
Error: accepts 2 arg(s), received 1
-- errauth.txt --
Error: you are not authorized to do this
-- errrepo.txt --
Error: invalid repo
