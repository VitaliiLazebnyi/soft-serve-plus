# vi: set ft=conf

# convert crlf to lf on windows
[windows] dos2unix commit1.txt CHANGELOG

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create a repo from a fixed commit, so the import needs no network and the
# commit hash is stable
soft repo create src
git clone ssh://localhost:$SSH_PORT/src src
cp CHANGELOG src/CHANGELOG
env GIT_AUTHOR_NAME='Daniel Ripolles'
env GIT_AUTHOR_EMAIL=daniel@example.com
env GIT_AUTHOR_DATE='2015-03-31T11:44:52Z'
env GIT_COMMITTER_NAME='Daniel Ripolles'
env GIT_COMMITTER_EMAIL=daniel@example.com
env GIT_COMMITTER_DATE='2015-03-31T11:44:52Z'
git -C src add -A
git -C src commit -m 'Creating changelog'
git -C src push origin HEAD
soft repo import basic1 ssh://git@127.0.0.1:$SSH_PORT/src

# print commit
soft repo commit basic1 5d88af6d7385fd069ff1464275f351146186b04a
cmp stdout commit1.txt

# a commit named by another revision prints its hash too
soft repo commit basic1 HEAD
cmp stdout commit1.txt

# stop the server
[windows] stopserver
[windows] ! stderr .

-- commit1.txt --
commit 5d88af6d7385fd069ff1464275f351146186b04a
Author: Daniel Ripolles
Date:   Tue Mar 31 11:44:52 UTC 2015
Creating changelog


CHANGELOG | 1 +
1 file changed, 1 insertion(+)

diff --git a/CHANGELOG b/CHANGELOG
new file mode 100644
index 0000000000000000000000000000000000000000..d3ff53e0564a9f87d8e84b6e28e5060e517008aa
--- /dev/null
+++ b/CHANGELOG
@@ -0,0 +1 @@
+Initial changelog

-- CHANGELOG --
Initial changelog
