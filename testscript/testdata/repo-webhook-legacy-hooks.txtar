# vi: set ft=conf

# A repository whose hooks were generated by an older version, which call
# `soft hook <hook>` for every hook, still runs its custom hooks and sends
# each push's webhooks once: the server sends them, from the refs that
# `soft hook post-receive` records for it.

# A Windows checkout gives this file CRLF line ends, and with it the hook
# scripts and the expected output below; they are made LF. The hooks'
# output is compared as written.
[windows] dos2unix legacy-pre-receive legacy-update legacy-post-receive legacy-post-update record.sh post-receive.txt

mkdir out
env HOOK_OUT=$WORK/out

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

soft repo create repo1
new-webhook WH_LEGACY
soft repo webhook create repo1 $WH_LEGACY -e branch_tag_create -e push

# the hooks as an older version wrote them
cp legacy-pre-receive $DATA_PATH/repos/repo1.git/hooks/pre-receive.d/soft-serve
cp legacy-update $DATA_PATH/repos/repo1.git/hooks/update.d/soft-serve
cp legacy-post-receive $DATA_PATH/repos/repo1.git/hooks/post-receive.d/soft-serve
cp legacy-post-update $DATA_PATH/repos/repo1.git/hooks/post-update.d/soft-serve
chmod 0755 $DATA_PATH/repos/repo1.git/hooks/pre-receive.d/soft-serve
chmod 0755 $DATA_PATH/repos/repo1.git/hooks/update.d/soft-serve
chmod 0755 $DATA_PATH/repos/repo1.git/hooks/post-receive.d/soft-serve
chmod 0755 $DATA_PATH/repos/repo1.git/hooks/post-update.d/soft-serve
# and a server-wide custom post-receive hook
cp record.sh $DATA_PATH/hooks/post-receive
chmod 0755 $DATA_PATH/hooks/post-receive

git clone ssh://localhost:$SSH_PORT/repo1 repo1
mkfile ./repo1/README.md 'hello'
git -C repo1 add -A
git -C repo1 commit -m 'first'
git -C repo1 push origin HEAD
webhook-received 2
[windows] dos2unix received-first.txt
cmp stdout received-first.txt
# the custom hook ran, through soft
exec git -C repo1 rev-parse HEAD
cp stdout head1
envfile HEAD1=head1
cmpenv out/post-receive post-receive.txt

# A second push is the fence: the server sends a repository's push events one
# push at a time, in order, so its event comes after any second copy of the
# first push's, and the list shows there was none.
mkfile ./repo1/README.md 'again'
git -C repo1 commit -am 'second'
git -C repo1 push origin HEAD
webhook-received 3
[windows] dos2unix received-second.txt
cmp stdout received-second.txt
webhook-deliveries repo1 1 3
stdout -count=3 '✅'

# stop the server
[windows] stopserver

-- legacy-pre-receive --
#!/bin/sh
# AUTO GENERATED BY SOFT SERVE, DO NOT MODIFY
if [ -z "$SOFT_SERVE_REPO_NAME" ]; then
	echo "Warning: SOFT_SERVE_REPO_NAME not defined. Skipping hooks."
	exit 0
fi
"${SOFT_SERVE_BIN_PATH}" hook pre-receive
-- legacy-update --
#!/bin/sh
# AUTO GENERATED BY SOFT SERVE, DO NOT MODIFY
if [ -z "$SOFT_SERVE_REPO_NAME" ]; then
	echo "Warning: SOFT_SERVE_REPO_NAME not defined. Skipping hooks."
	exit 0
fi
"${SOFT_SERVE_BIN_PATH}" hook update "$1" "$2" "$3"
-- legacy-post-receive --
#!/bin/sh
# AUTO GENERATED BY SOFT SERVE, DO NOT MODIFY
if [ -z "$SOFT_SERVE_REPO_NAME" ]; then
	echo "Warning: SOFT_SERVE_REPO_NAME not defined. Skipping hooks."
	exit 0
fi
"${SOFT_SERVE_BIN_PATH}" hook post-receive
-- legacy-post-update --
#!/bin/sh
# AUTO GENERATED BY SOFT SERVE, DO NOT MODIFY
if [ -z "$SOFT_SERVE_REPO_NAME" ]; then
	echo "Warning: SOFT_SERVE_REPO_NAME not defined. Skipping hooks."
	exit 0
fi
"${SOFT_SERVE_BIN_PATH}" hook post-update "$@"
-- record.sh --
#!/bin/sh
{
	printf 'args:'
	for a in "$@"; do printf ' %s' "$a"; done
	printf '\n'
	cat
} >>"$HOOK_OUT/$(basename "$0")"
-- post-receive.txt --
args:
0000000000000000000000000000000000000000 $HEAD1 refs/heads/master
-- received-first.txt --
branch_tag_create /hooks/WH_LEGACY
push /hooks/WH_LEGACY
-- received-second.txt --
branch_tag_create /hooks/WH_LEGACY
push /hooks/WH_LEGACY
push /hooks/WH_LEGACY
