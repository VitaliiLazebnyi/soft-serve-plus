# vi: set ft=conf

# FIXME: don't skip windows
[windows] skip 'curl makes github actions hang'

# With admin_only_create on, only an account with the admin flag may create a
# repository by pushing over HTTP. Owning a key listed in initial_admin_keys
# does not count: `pubkey add` takes any public key without proof of holding
# its private half, so a user could claim a key before an operator lists it.

env SOFT_SERVE_ADMIN_ONLY_CREATE=true

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

soft settings anon-access read-write

# user1 is an ordinary account; it claims admin2's public key, which is not
# an admin key yet
soft user create user1 --key "$USER1_AUTHORIZED_KEY"
usoft pubkey add "$ADMIN2_AUTHORIZED_KEY"
usoft token create 'push'
stdout '^ss_[0-9a-f]+$'
cp stdout utokenfile
envfile UTOKEN=utokenfile

# the admin account (admin flag) gets a token too
soft token create 'push'
stdout '^ss_[0-9a-f]+$'
cp stdout atokenfile
envfile ATOKEN=atokenfile

# an ordinary account cannot push-to-create over HTTP
curl -v http://$UTOKEN@localhost:$HTTP_PORT/before.git/info/refs?service=git-receive-pack
stderr '^> 404 '

# the operator now lists the claimed key as an admin key
stopserver
ensureservernotrunning SSH_PORT
env SOFT_SERVE_INITIAL_ADMIN_KEYS=$ADMIN2_AUTHORIZED_KEY
exec soft serve &
ensureserverrunning SSH_PORT

soft user info user1
stdout 'Admin: false'

# user1 still cannot create over HTTP, by token or by basic auth
curl -v http://$UTOKEN@localhost:$HTTP_PORT/claimed.git/info/refs?service=git-receive-pack
stderr '^> 404 '
curl -v http://user1:$UTOKEN@localhost:$HTTP_PORT/claimed2.git/info/refs?service=git-receive-pack
stderr '^> 404 '
# nor can an anonymous caller
curl -v http://localhost:$HTTP_PORT/anon.git/info/refs?service=git-receive-pack
stderr '^> 401 '

# while listed, a non-admin cannot attach the key to their account
usoft pubkey remove "$ADMIN2_AUTHORIZED_KEY"
! usoft pubkey add "$ADMIN2_AUTHORIZED_KEY"
stderr 'listed in initial_admin_keys'

# the account with the admin flag creates by push over HTTP
curl http://$ATOKEN@localhost:$HTTP_PORT/admin-made.git/info/refs?service=git-receive-pack
stdout '.*git-receive-pack.*'

soft repo list
stdout 'admin-made'
! stdout 'before'
! stdout 'claimed'
! stdout 'anon'

# stop the server
[windows] stopserver
[windows] ! stderr .
