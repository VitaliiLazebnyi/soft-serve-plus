# vi: set ft=conf

# `soft hook`, which hooks generated by an older version run, reads the
# config the server runs with from the file the server writes at start, not
# config.yaml: an edit or a typo in config.yaml after the start does not
# break pushes. A config it cannot load fails the hook with a generic error
# for the client; the details go to the hook log.

# A Windows checkout gives this file CRLF line ends, and with it the hook
# script below; it is made LF.
[windows] dos2unix legacy-pre-receive

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

soft repo create repo1
# the hooks as an older version wrote them
cp legacy-pre-receive $DATA_PATH/repos/repo1.git/hooks/pre-receive.d/soft-serve
chmod 0755 $DATA_PATH/repos/repo1.git/hooks/pre-receive.d/soft-serve
exists $DATA_PATH/hook-config.yaml

# a typo in config.yaml while the server runs
cp $DATA_PATH/config.yaml config.yaml.orig
mkfile $DATA_PATH/config.yaml 'ssh: {max_timeout: -5}'

git clone ssh://localhost:$SSH_PORT/repo1 repo1
mkfile ./repo1/README.md 'hello'
git -C repo1 add -A
git -C repo1 commit -m 'first'
git -C repo1 push origin HEAD
! stderr 'max_timeout'
! stderr 'FATAL'
soft repo branch list repo1
stdout '^master$'

# a hook config that cannot be read fails the push with a generic error
mkfile $DATA_PATH/hook-config.yaml 'ssh: [broken'
mkfile ./repo1/README.md 'again'
git -C repo1 commit -am 'second'
! git -C repo1 push origin HEAD
stderr 'internal server error'
! stderr 'broken'
! stderr 'hook-config'
grep 'failed to load the server config' $DATA_PATH/log/hooks.log

# stop the server
cp config.yaml.orig $DATA_PATH/config.yaml
[windows] stopserver

-- legacy-pre-receive --
#!/bin/sh
# AUTO GENERATED BY SOFT SERVE, DO NOT MODIFY
if [ -z "$SOFT_SERVE_REPO_NAME" ]; then
	echo "Warning: SOFT_SERVE_REPO_NAME not defined. Skipping hooks."
	exit 0
fi
"${SOFT_SERVE_BIN_PATH}" hook pre-receive
