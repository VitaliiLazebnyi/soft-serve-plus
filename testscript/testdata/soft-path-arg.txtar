# vi: set ft=conf

# "soft PATH" hands PATH to browse instead of rejecting it as a command
mkdir notrepo
! exec soft notrepo
stderr 'failed to open repository'
! stderr 'unknown command'

# a word that is not a path is still reported as an unknown command
! exec soft brwse
stderr 'unknown command "brwse" for "soft"'
stderr 'browse'

! exec soft notrepo notrepo
stderr 'accepts at most 1 arg'
