# vi: set ft=conf

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create user
soft user create user1 --key "$USER1_AUTHORIZED_KEY"

# create access tokens
usoft token create 'test1'
stdout '^ss_[0-9a-f]+$'
stderr 'Access token created'
usoft token create --expires-in 1y 'test2'
stdout '^ss_[0-9a-f]+$'
stderr 'Access token created'
usoft token create --expires-in 1ns 'test3'
stdout '^ss_[0-9a-f]+$'
stderr 'Access token created'

# list tokens
usoft token list
cp stdout tokens.txt
grep '1.*test1.*-' tokens.txt
grep '2.*test2.*1 year from now' tokens.txt
grep '3.*test3.*expired' tokens.txt

# another user cannot delete the token, and gets the same answer as for an
# unused ID
! soft token delete 2
stderr 'token not found'
! soft token delete 99
stderr 'token not found'
usoft token list
stdout 'test2'

# delete token
usoft token delete 1
stderr 'Access token deleted'
! usoft token delete 1
stderr 'token not found'

# stop the server
[windows] stopserver
