# vi: set ft=conf

# git and git-lfs dial the remote and the LFS action URLs (built from the
# public URL) themselves, so both name the address the server listens on
env SOFT_SERVE_HTTP_PUBLIC_URL=http://127.0.0.1:$HTTP_PORT

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT
# something else holds the HTTP port on ::1; clients must not depend on
# which address "localhost" resolves to first
occupyipv6 HTTP_PORT

# create user
soft user create user1 --key "$USER1_AUTHORIZED_KEY"

# create access token
soft token create --expires-in '1h' 'repo2'
cp stdout tokenfile
envfile TOKEN=tokenfile
soft token create --expires-in '1ns' 'repo2'
cp stdout etokenfile
envfile ETOKEN=etokenfile
usoft token create 'repo2'
cp stdout utokenfile
envfile UTOKEN=utokenfile

# push & create repo with some files, commits, tags...
mkdir ./repo2
git -c init.defaultBranch=master -C repo2 init
mkfile ./repo2/README.md '# Project\nfoo'
mkfile ./repo2/foo.png 'foo'
mkfile ./repo2/bar.png 'bar'
# Pass the token through a credential helper, not the URL. Git on some
# platforms (Homebrew git on macOS) thinks a URL with credentials was
# redirected, drops them, and fails the push. Tests do not read system or
# global git config, so the empty helper (which resets the helper list) is
# only a guard that keeps the token from being stored outside the test.
git -C repo2 remote add origin http://127.0.0.1:$HTTP_PORT/repo2
git -C repo2 config credential.helper ''
git -C repo2 config --add credential.helper '!f() { echo username=soft; echo password='$TOKEN'; }; f'
git -C repo2 lfs install --local
git -C repo2 lfs track '*.png'
git -C repo2 add -A
git -C repo2 commit -m 'first'
git -C repo2 tag v0.1.0
git -C repo2 push origin HEAD
git -C repo2 push origin HEAD --tags

# The CORS handler answers every preflight with 200 OK, allowed or not, so
# the checks look at the Access-Control-Allow-Origin header.

# the public url is always allowed
curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2/git-upload-pack -H 'Origin: http://127.0.0.1:'$HTTP_PORT -H 'Access-Control-Request-Method: POST'
stderr '> 200 OK'
stderr '> Access-Control-Allow-Origin: http://127.0.0.1:'$HTTP_PORT

# by default the server does not allow example.com, so the response does not
# have the "Access-Control-Allow-Origin" header and cors will fail.
curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2/git-upload-pack -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: POST'
stderr '> 200 OK'
! stderr 'Access-Control-Allow-Origin'

# stop the server
stopserver

# allow cross-origin OPTIONS requests for example.com
env SOFT_SERVE_HTTP_CORS_ALLOWED_ORIGINS=https://example.com
env SOFT_SERVE_HTTP_CORS_ALLOWED_METHODS=GET,OPTIONS
env SOFT_SERVE_HTTP_CORS_ALLOWED_HEADERS=Origin,Access-Control-Request-Method

# restart soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT
ensureserverrunning HTTP_PORT

curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2.git/info/refs -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: GET'
stderr '> 200 OK'
stderr '> Access-Control-Allow-Origin: https://example.com'

# the public url is still allowed
curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2.git/info/refs -H 'Origin: http://127.0.0.1:'$HTTP_PORT -H 'Access-Control-Request-Method: GET'
stderr '> 200 OK'
stderr '> Access-Control-Allow-Origin: http://127.0.0.1:'$HTTP_PORT

# POST is allowed by default but not by the configured methods
curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2/git-upload-pack -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: POST'
stderr '> 405 Method Not Allowed'
! stderr 'Access-Control-Allow-Origin'

# Access-Control-Request-Method is not allowed by default but is in the
# configured headers
curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2.git/info/refs -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: GET' -H 'Access-Control-Request-Headers: Access-Control-Request-Method'
stderr '> 200 OK'
stderr '> Access-Control-Allow-Origin: https://example.com'

# Authorization is allowed by default but not by the configured headers
curl -v --request OPTIONS http://localhost:$HTTP_PORT/repo2.git/info/refs -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: GET' -H 'Access-Control-Request-Headers: Authorization'
stderr '> 403 Forbidden'
! stderr 'Access-Control-Allow-Origin'

# stop the server
[windows] stopserver
