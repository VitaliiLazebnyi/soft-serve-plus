# vi: set ft=conf

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# setup
soft repo create test
soft user create foo --key "$USER1_AUTHORIZED_KEY"

# list collabs
soft repo collab list test
! stdout .

# add collab
soft repo collab add test foo
soft repo collab list test
stdout '^foo\tread-write$'

# remove collab
soft repo collab remove test foo
soft repo collab list test
! stdout .

# create empty repo
soft repo create empty '-d "empty repo"'

# add collab
soft repo collab add empty foo
# add collab again
# test issue #464 https://github.com/charmbracelet/soft-serve/issues/464
! soft repo collab add empty foo
stderr '.*already exists.*'
# a placeholder to reset stderr
soft help

# a no-access collaborator cannot read a private repo (GHSA-pmgj-8mr6-9rff)
soft repo create secret -p
! usoft repo description secret
stderr '.*repository not found.*'
soft repo collab add secret foo no-access
! usoft repo description secret
stderr '.*repository not found.*'
soft repo collab remove secret foo
soft repo collab add secret foo read-only
usoft repo description secret

# collab list shows each collaborator's access level
soft user create bar
soft repo collab add secret bar admin-access
soft repo collab list secret
stdout '^foo\tread-only$'
stdout '^bar\tadmin-access$'

# a read-write collaborator cannot manage collaborators; with anon-access
# no-access they could otherwise lock a registered user out of a public
# repository by adding them as no-access
soft settings anon-access no-access
soft user create baz
soft repo create open
soft repo collab add open foo read-write
! usoft repo collab add open baz no-access
stderr 'unauthorized'
! usoft repo collab add open bar read-only
stderr 'unauthorized'
soft repo collab add open bar read-write
! usoft repo collab remove open bar
stderr 'unauthorized'
usoft repo collab list open
stdout '^bar\tread-write$'
! stdout 'baz'

# an admin-access collaborator can
soft repo collab remove open foo
soft repo collab add open foo admin-access
usoft repo collab add open baz read-only
usoft repo collab remove open bar
usoft repo collab list open
stdout '^baz\tread-only$'
! stdout 'bar'
soft settings anon-access read-only

# stop the server
[windows] stopserver
[windows] ! stderr .
