# vi: set ft=conf

# Deliveries of push events, which the server records after each push, are
# pruned to the newest ones on every record. The test build lets the limit be
# lowered to 3.
env SOFT_SERVE_TEST_WEBHOOK_MAX_DELIVERIES=3

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

soft repo create repo-ret
new-webhook WH_RET
soft repo webhook create repo-ret $WH_RET -e branch_tag_create -e branch_tag_delete

git clone ssh://localhost:$SSH_PORT/repo-ret repo-ret
mkfile ./repo-ret/README.md 'foobar'
git -C repo-ret add -A
git -C repo-ret commit -m 'first'

# five events, from five pushes, recorded in this order:
# create main, create v1, delete v1, create v2, create v3
git -C repo-ret push origin HEAD
git -C repo-ret tag v1
git -C repo-ret push origin v1
git -C repo-ret push origin --delete v1
git -C repo-ret tag v2
git -C repo-ret push origin v2
git -C repo-ret tag v3
git -C repo-ret push origin v3

# all five were sent
webhook-received 5
stdout -count=4 '^branch_tag_create '
stdout -count=1 '^branch_tag_delete '

# only the three most recent are kept, oldest first: delete v1, create v2,
# create v3. The list is in recording order, and the only three of the five
# events that read delete, create, create in that order are the last three.
# A delivery is pruned after it is recorded, so between the two the list
# also holds create v1, on its first row; the wait is for the delete on the
# first row (after the header's ┤), which the list reads once the last
# record's prune is done.
webhook-deliveries repo-ret 1 3 '(?s)┤\r?\n│[^\n]*│branch_tag_delete│.*branch_tag_create.*branch_tag_create'
stdout -count=3 '✅'
stdout -count=2 'branch_tag_create'
stdout -count=1 'branch_tag_delete'
stdout '(?s)branch_tag_delete.*branch_tag_create.*branch_tag_create'

# stop the server
[windows] stopserver
[windows] ! stderr .
