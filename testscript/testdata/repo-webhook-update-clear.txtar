# vi: set ft=conf

# webhook update replaces a value whose flag is given, even with an empty
# value: --events= unsubscribes the webhook from every event. Flags left out
# keep their value, and an empty URL is refused.

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

soft repo create repo-clear
soft repo webhook create repo-clear https://93.184.216.34/hook -s secret -e push -e repository
soft repo webhook list repo-clear
stdout '1.*93.184.216.34/hook.*push,repository.*true'

# an empty --events removes every event and keeps everything else
soft repo webhook update repo-clear 1 --events= --secret=
soft repo webhook list repo-clear
stdout '1 *│https://93.184.216.34/hook *│ *│true'
! stdout 'push'

# events can be set again
soft repo webhook update repo-clear 1 -e push
soft repo webhook list repo-clear
stdout '1.*93.184.216.34/hook.*push.*true'

# an empty URL is refused rather than ignored
! soft repo webhook update repo-clear 1 --url=
stderr 'invalid'
soft repo webhook list repo-clear
stdout '1.*93.184.216.34/hook.*push.*true'

# stop the server
[windows] stopserver
[windows] ! stderr .
